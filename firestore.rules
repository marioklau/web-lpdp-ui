rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin bisa ditambahkan lewat custom claim `admin`, dokumen
    // config/admin berisi field `uids`, atau daftar bootstrap di bawah.
    // Dokumen config/admin dibuat manual lewat Firebase Console.
    function isAdmin() {
      return request.auth != null
        && (
          request.auth.token.admin == true
          || request.auth.uid in [
            '7QdiAC3pupNTKOlZX6hYjdwwsdM2',
            'KULwbZ60JhVm3EWrFjPGK7SFFqi2'
          ]
          || (
            exists(/databases/$(database)/documents/config/admin)
            && request.auth.uid in get(/databases/$(database)/documents/config/admin).data.get('uids', [])
          )
        );
    }

    match /config/admin {
      allow read, write: if false;
    }

    // Seluruh konten situs disimpan dalam satu dokumen.
    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Penghitung kunjungan dan hati. Pengunjung hanya boleh menambah satu angka.
    match /site/metrics {
      function validMetrics(data) {
        return data.keys().hasOnly(['views', 'loves'])
          && data.views is int
          && data.loves is int
          && data.views >= 0
          && data.loves >= 0
          && data.views <= 100000000
          && data.loves <= 100000000;
      }

      allow read: if true;
      allow create: if validMetrics(request.resource.data)
        && request.resource.data.views <= 1
        && request.resource.data.loves <= 1
        && request.resource.data.views + request.resource.data.loves == 1;
      allow update: if validMetrics(request.resource.data)
        && (
          (
            request.resource.data.views == resource.data.views + 1
            && request.resource.data.loves == resource.data.loves
          )
          || (
            request.resource.data.loves == resource.data.loves + 1
            && request.resource.data.views == resource.data.views
          )
        );
      allow delete: if false;
    }

    // Pengunjung boleh membuat pengajuan, hanya admin yang boleh membaca/menghapus.
    match /letterSubmissions/{submissionId} {
      allow create: if request.resource.data.templateId is string
        && request.resource.data.templateId.size() <= 128
        && request.resource.data.templateTitle is string
        && request.resource.data.templateTitle.size() <= 256
        && request.resource.data.fields is map
        && request.resource.data.fields.size() <= 60
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
      allow read, delete: if isAdmin();
    }

    // Pengunjung boleh mengirim aspirasi, hanya admin yang boleh membaca.
    match /aspirations/{aspirationId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;
      allow read, delete: if isAdmin();
    }

    // Pasar awardee: iklan dapat dibaca publik dan dibuat pengunjung.
    // Moderasi (ubah/hapus) hanya untuk admin. Transaksi di luar platform.
    match /marketListings/{listingId} {
      function validListing(data) {
        return data.keys().hasOnly([
            'sellerName',
            'contact',
            'city',
            'title',
            'category',
            'condition',
            'price',
            'description',
            'imageUrl',
            'createdAt'
          ])
          && data.sellerName is string
          && data.sellerName.size() > 0
          && data.sellerName.size() <= 120
          && data.contact is string
          && data.contact.size() > 0
          && data.contact.size() <= 80
          && data.city is string
          && data.city.size() <= 120
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 160
          && data.category is string
          && data.category.size() <= 60
          && data.condition is string
          && data.condition.size() <= 60
          && data.price is int
          && data.price >= 0
          && data.price <= 1000000000000
          && data.description is string
          && data.description.size() > 0
          && data.description.size() <= 2000
          && data.imageUrl is string
          && data.imageUrl.size() <= 200000
          && data.createdAt is string
          && data.createdAt.size() <= 40;
      }

      allow read: if true;
      allow create: if validListing(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Katalog kos: data dikelola admin, publik boleh membaca dan memberi rating.
    // Rating hanya boleh menambah ratingSum (1-5) dan ratingCount (+1).
    match /kosListings/{listingId} {
      function validKos(data) {
        return data.keys().hasOnly([
            'name',
            'campus',
            'gender',
            'address',
            'price',
            'facilities',
            'contact',
            'imageUrl',
            'lat',
            'lng',
            'notes',
            'ratingSum',
            'ratingCount',
            'createdAt'
          ])
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 160
          && data.campus is string
          && data.campus in ['depok', 'salemba']
          && data.gender is string
          && data.gender in ['putra', 'putri', 'campur']
          && data.address is string
          && data.address.size() > 0
          && data.address.size() <= 300
          && data.price is int
          && data.price >= 0
          && data.price <= 100000000000
          && data.facilities is list
          && data.facilities.size() <= 30
          && data.contact is string
          && data.contact.size() <= 80
          && data.imageUrl is string
          && data.imageUrl.size() <= 200000
          && data.lat is number
          && data.lat >= -90
          && data.lat <= 90
          && data.lng is number
          && data.lng >= -180
          && data.lng <= 180
          && data.notes is string
          && data.notes.size() <= 2000
          && data.ratingSum is int
          && data.ratingSum >= 0
          && data.ratingCount is int
          && data.ratingCount >= 0
          && data.createdAt is string
          && data.createdAt.size() <= 40;
      }

      allow read: if true;
      allow create: if isAdmin()
        && validKos(request.resource.data)
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingCount == 0;
      allow update: if validKos(request.resource.data)
        && (
          isAdmin()
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'ratingSum',
              'ratingCount'
            ])
            && request.resource.data.ratingSum >= resource.data.ratingSum + 1
            && request.resource.data.ratingSum <= resource.data.ratingSum + 5
            && request.resource.data.ratingCount == resource.data.ratingCount + 1
          )
        );
      allow delete: if isAdmin();
    }
  }
}
